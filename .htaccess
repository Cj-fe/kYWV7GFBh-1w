# Enable the rewrite engine
RewriteEngine On

# Base directory - adjust if your site is in a subdirectory
RewriteBase /

# If the requested URL is a directory that doesn't exist
RewriteCond %{REQUEST_FILENAME} !-d

# And if the requested URL is not a file
RewriteCond %{REQUEST_FILENAME} !-f

# Then redirect to index.html
RewriteRule ^(.*)$ index.html [L,QSA]

# Also explicitly handle 404 errors
ErrorDocument 404 /index.html

# Prevent directory listing
Options -Indexes

# If you're still having issues, try this more aggressive approach:
# This will redirect ALL requests that don't match an existing file to index.html
# Uncomment the line below if the above rules aren't working
# RewriteRule ^.*$ index.html [L,QSA]